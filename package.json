{
  "name": "itar-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.9"
  },
  "scripts": {
    "typecheck": "node scripts/prepare-tv-types.cjs && tsc --noEmit",
    "lint": "eslint packages scripts --ext .js,.cjs,.ts,.tsx",
    "test": "node --test scripts/*.test.cjs",
    "build": "npm run build -w @bougarnem/itar",
    "native:fixture": "node scripts/generate-native-consumer.cjs",
    "build:web:engine": "node packages/itar/web-runtime/engine/build.cjs",
    "typecheck:web": "node scripts/prepare-tv-types.cjs && tsc --noEmit -p tsconfig.web.json",
    "test:web": "node --test packages/itar/web-runtime/engine/*.test.mjs packages/itar/web-runtime/tests/*.test.cjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.28.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/react-native-web": "0.19.2",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "prettier": "2.8.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.0-0",
    "react-native-web": "0.21.4",
    "typescript": "5.8.3"
  }
}
