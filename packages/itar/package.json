{
  "name": "itar",
  "version": "0.0.0",
  "private": true,
  "description": "React Native TV focus package; Android adapter preview",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "lib",
    "src",
    "android"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "19.2.0",
    "react-native": "0.83.0-0"
  },
  "codegenConfig": {
    "name": "ItarSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.itar.adapter"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./android": {
      "types": "./lib/android.d.ts",
      "react-native": "./src/android.ts",
      "default": "./lib/android.js"
    },
    "./package.json": "./package.json"
  }
}
