{
  "name": "itar",
  "version": "0.0.0",
  "private": true,
  "description": "React Native TV focus package; native adapter and React API preview",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "lib",
    "src",
    "android",
    "apple",
    "*.podspec",
    "cpp",
    "LICENSE",
    "README.md",
    "README.ar.md",
    "virtualization.md",
    "virtualization.ar.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node scripts/prepare-package.cjs"
  },
  "peerDependencies": {
    "react": "19.2.0",
    "react-native": "0.83.0-0"
  },
  "codegenConfig": {
    "name": "ItarSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.itar.adapter"
    },
    "ios": {
      "componentProvider": {
        "ItarSurface": "ItarSurfaceComponentView",
        "ItarScope": "ItarScopeComponentView",
        "ItarTarget": "ItarTargetComponentView"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./android": {
      "types": "./lib/android.d.ts",
      "react-native": "./src/android.ts",
      "default": "./lib/android.js"
    },
    "./apple": {
      "types": "./lib/apple.d.ts",
      "react-native": "./src/apple.ts",
      "default": "./lib/apple.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "react-native": "./src/react.tsx",
      "default": "./lib/react.js"
    },
    "./package.json": "./package.json"
  }
}
