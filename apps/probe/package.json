{
  "name": "itar-probe",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .js,.cjs,.ts,.tsx --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{js,cjs,ts,tsx,json}\" && npm run lint:fix && prettier --write \"**/*.{js,cjs,ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,ts,tsx,json}\"",
    "check": "npm run lint && npm run format:check",
    "start": "react-native start --port 8096",
    "android": "react-native run-android --port 8096",
    "tvos": "react-native run-ios --port 8096 --scheme ItarProbe",
    "bundle": "react-native bundle --entry-file index.js --platform android --dev false --bundle-output ../../build/probe.android.js --max-workers 2",
    "build:web": "npm run build:web --prefix ../..",
    "build:tizen": "npm run build:tizen --prefix ../..",
    "build:webos": "npm run build:webos --prefix ../..",
    "web": "npm run web --prefix ../.."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "itar": "0.1.0-beta",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.0-0",
    "react-native-video": "6.19.3",
    "react-native-web": "0.21.4",
    "react-tv-space-navigation": "5.2.0"
  }
}
